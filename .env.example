# Kopieren nach .env.local und ausfüllen. .env.local wird nie committet.
# Dieselben Werte auch in Vercel unter Settings → Environment Variables eintragen.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<projekt-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Geheim, nur serverseitig. Umgeht Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Workers AI (Dashboard → Account ID, API-Token nur mit Berechtigung "Workers AI")
CLOUDFLARE_ACCOUNT_ID=
# Geheim, nur serverseitig.
CLOUDFLARE_API_TOKEN=

# Modelle (nur Open-Source-Lizenzen, siehe CLAUDE.md). Chat-Modell wird in V-04 festgelegt.
CHAT_MODEL=
EMBEDDING_MODEL=@cf/baai/bge-m3
